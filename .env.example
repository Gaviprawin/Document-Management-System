APP_NAME=Document Management API
DEBUG=False

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=document_management_db
MYSQL_USER=document_user
MYSQL_PASSWORD=root

DATABASE_URL=mysql+pymysql://document_user:root@localhost:3306/document_management_db

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://

DOCUMENT_STORAGE_DIR=storage/documents
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5